# Copy to .env and replace both values with strong local development secrets.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_DATABASE=machi_next
MYSQL_USER=machi_app
MYSQL_PASSWORD=replace-with-a-long-random-app-password
MYSQL_PORT=3306
MYSQL_BIND_ADDRESS=127.0.0.1
# Generate a private random value of at least 32 characters for JWT signing.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_TTL_MINUTES=60
